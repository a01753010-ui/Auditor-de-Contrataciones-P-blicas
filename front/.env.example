# Copia este archivo como .env.local y ajusta los valores.

# true  = el front funciona solo, con un backend simulado en el navegador.
# false = usa el backend Flask del equipo (casos, reportes en S3, inicio de sesión).
VITE_USE_MOCK=true

# Prefijo de la API. Con el proxy de Vite basta con /api (se quita antes de llegar a Flask).
# Sin proxy puede ser la URL completa del backend, p. ej. http://<ec2>:5000;
# en ese caso el backend necesita CORS_ORIGENES con el origen del front.
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo (solo lo usa vite.config.ts).
BACKEND_URL=http://localhost:5000
